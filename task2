attendance = {}

files = ["C:/Users/aswin_emqxda7/OneDrive/Documents/day1.txt"]

for file in files:
    try:
        f = open(file, "r")

        for line in f:
            parts = line.strip().split(",")

            if len(parts) != 3:
                print("Invalid line")
                continue

            reg = parts[0]
            status = parts[2]

            if reg not in attendance:
                attendance[reg] = [0, 0]

            attendance[reg][0] += 1

            if status == "P":
                attendance[reg][1] += 1

        f.close()
